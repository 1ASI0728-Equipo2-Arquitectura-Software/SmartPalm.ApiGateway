{
  "Jwt": { 
    "Issuer": "smartpalm.identity", 
    "Audience": "smartpalm.clients", 
    "Key": "" 
  },
  "SwaggerServices": {
    "Identity": "http://localhost:5101",
    "Crop": "http://localhost:5102",
    "Device": "http://localhost:5103",
    "Ingestion": "http://localhost:5104",
    "Alert": "http://localhost:5105",
    "Agronomy": "http://localhost:5106",
    "Field": "http://localhost:5107"
  },
  "ReverseProxy": {
    "Routes": {
      "swagger-identity": { "ClusterId": "identity-service", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/swagger/services/identity/swagger.json" }, "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }] },
      "swagger-crop": { "ClusterId": "crop-service", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/swagger/services/crop/swagger.json" }, "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }] },
      "swagger-device": { "ClusterId": "device-service", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/swagger/services/device/swagger.json" }, "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }] },
      "swagger-ingestion": { "ClusterId": "ingestion-service", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/swagger/services/ingestion/swagger.json" }, "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }] },
      "swagger-alert": { "ClusterId": "alert-service", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/swagger/services/alert/swagger.json" }, "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }] },
      "swagger-agronomy": { "ClusterId": "agronomy-service", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/swagger/services/agronomy/swagger.json" }, "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }] },
      "swagger-field": { "ClusterId": "field-service", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/swagger/services/field/swagger.json" }, "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }] },
      "identity-authentication": { "ClusterId": "identity-service", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/api/v1/Authentication/{**catch-all}" } },
      "identity-public-plans": { "ClusterId": "identity-service", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/api/v1/subscriptions/plans" } },
      "identity-admin-users": { "ClusterId": "identity-service", "AuthorizationPolicy": "Administrator", "Match": { "Path": "/api/v1/admin/users/{**catch-all}" } },
      "identity-admin-subscriptions": { "ClusterId": "identity-service", "AuthorizationPolicy": "Administrator", "Match": { "Path": "/api/v1/admin/subscriptions/{**catch-all}" } },
      "identity-users": { "ClusterId": "identity-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/users/{**catch-all}" } },
      "identity-subscriptions": { "ClusterId": "identity-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/subscriptions/{**catch-all}" } },
      "crop-admin": { "ClusterId": "crop-service", "AuthorizationPolicy": "Administrator", "Match": { "Path": "/api/v1/admin/plantations/{**catch-all}" } },
      "crop-plantations": { "ClusterId": "crop-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/plantations/{**catch-all}" } },
      "crop-agronomists": { "ClusterId": "crop-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/agronomists/{**catch-all}" } },
      "ingestion-edge-readings": { "ClusterId": "ingestion-service", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/api/v1/edge-gateways/{gatewayMac}/sensor-readings", "Methods": [ "POST" ] } },
      "ingestion-edge-readings-get": { "ClusterId": "ingestion-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/edge-gateways/{gatewayMac}/sensor-readings", "Methods": [ "GET" ] } },
      "device-connectivity": { "ClusterId": "device-service", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/api/v1/edge-gateways/{gatewayMac}/connectivity" } },
      "device-admin": { "ClusterId": "device-service", "AuthorizationPolicy": "Administrator", "Match": { "Path": "/api/v1/admin/edge-gateways/{**catch-all}" } },
      "device-admin-iot": { "ClusterId": "device-service", "AuthorizationPolicy": "Administrator", "Match": { "Path": "/api/v1/admin/iot-devices/{**catch-all}", "Methods": [ "POST" ] } },
      "device-gateways": { "ClusterId": "device-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/edge-gateways/{**catch-all}" } },
      "ingestion-sector-health": { "ClusterId": "ingestion-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/sectors/{sectorId}/health" } },
      "ingestion-sector-readings": { "ClusterId": "ingestion-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/sectors/{sectorId}/sensor-readings" } },
      "ingestion-devices": { "ClusterId": "ingestion-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/devices/{**catch-all}" } },
      "ingestion-admin-devices": { "ClusterId": "ingestion-service", "AuthorizationPolicy": "Administrator", "Match": { "Path": "/api/v1/admin/devices/{**catch-all}" } },
      "alert-admin": { "ClusterId": "alert-service", "AuthorizationPolicy": "Administrator", "Match": { "Path": "/api/v1/admin/alerts/{**catch-all}" } },
      "alert-alerts": { "ClusterId": "alert-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/alerts/{**catch-all}" } },
      "alert-settings": { "ClusterId": "alert-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/alert-settings/{**catch-all}" } },
      "agronomy-sector-recommendations": { "ClusterId": "agronomy-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/sectors/{sectorId}/recommendations/{**catch-all}" } },
      "agronomy-sector-reports": { "ClusterId": "agronomy-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/sectors/{sectorId}/reports/{**catch-all}" } },
      "agronomy-recommendations": { "ClusterId": "agronomy-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/recommendations/{**catch-all}" } },
      "agronomy-reports": { "ClusterId": "agronomy-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/reports/{**catch-all}" } },
      "field-api": { "ClusterId": "field-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/field/{**catch-all}" } },
      "field-sector-interventions": { "ClusterId": "field-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/sectors/{sectorId}/interventions/{**catch-all}" } },
      "field-plantation-interventions": { "ClusterId": "field-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/plantations/{plantationId}/interventions/{**catch-all}" } },
      "field-recommendation-interventions": { "ClusterId": "field-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/recommendations/{recommendationId}/interventions/{**catch-all}" } },
      "field-interventions": { "ClusterId": "field-service", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/interventions/{**catch-all}" } }
    },
    "Clusters": {
      "identity-service": { "HttpRequest": { "ActivityTimeout": "00:00:10" }, "Destinations": { "primary": { "Address": "http://localhost:5101" } } },
      "crop-service": { "HttpRequest": { "ActivityTimeout": "00:00:10" }, "Destinations": { "primary": { "Address": "http://localhost:5102" } } },
      "device-service": { "HttpRequest": { "ActivityTimeout": "00:00:10", "RequestHeadersCopy": true }, "Destinations": { "primary": { "Address": "http://localhost:5103" } } },
      "ingestion-service": { "HttpRequest": { "ActivityTimeout": "00:00:15", "RequestHeadersCopy": true }, "Destinations": { "primary": { "Address": "http://localhost:5104" } } },
      "alert-service": { "HttpRequest": { "ActivityTimeout": "00:00:10" }, "Destinations": { "primary": { "Address": "http://localhost:5105" } } },
      "agronomy-service": { "HttpRequest": { "ActivityTimeout": "00:00:10" }, "Destinations": { "primary": { "Address": "http://localhost:5106" } } },
      "field-service": { "HttpRequest": { "ActivityTimeout": "00:00:10" }, "Destinations": { "primary": { "Address": "http://localhost:5107" } } }
    }
  },
  "DownstreamServices": { 
    "HealthUrls": {
      "Identity": "http://localhost:5101/health/ready", 
      "Crop": "http://localhost:5102/health/ready", 
      "Device": "http://localhost:5103/health/ready", 
      "Ingestion": "http://localhost:5104/health/ready", 
      "Alert": "http://localhost:5105/health/ready", 
      "Agronomy": "http://localhost:5106/health/ready", 
      "Field": "http://localhost:5107/health/ready"
    } 
  },
  "Logging": { 
    "LogLevel": { 
      "Default": "Information", 
      "Microsoft.AspNetCore": "Warning", 
      "Yarp.ReverseProxy": "Information" 
    } 
  },
  "AllowedHosts": "*"
}
